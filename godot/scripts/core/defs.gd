static func make_name(rng: Rng, culture: String) -> String:
	var c: Array = CULTURES.get(culture, CULTURES["slavic"])
	var n: String = rng.pick(c[0])
	if rng.chance(0.4):
		n += rng.pick(c[1])
	n += rng.pick(c[2])
	return n


