le", "drop"], "sig": {"name": "Кавовий метеор", "icon": "☄️", "power": 1.5, "target": "all", "elem": "fire"}, "chapters": [{"bond": 15, "title": "Жаб'яча рада", "text": ["Нікса показує тобі старий лист: «Повернись, і ми все пробачимо. Рада магів (тепер знову люди)».", "Нікса: «Вони хотіли, щоб я зробила прокляття на ціле королівство. Я відмовилася. І... трохи їх заквакала.»", "Нікса: «Ти перший, хто не втік, почувши це. Цікаво.»"], "reward": {"stat": "int", "n": 2, "gold": 300}}, {"bond": 40, "title": "Рецепт", "text": ["Нікса варить дивне зілля і не підпускає тебе до котла.", "Нікса: «Це не любовне зілля. Не дивись так. Це... зілля від втоми. Для тебе. Ти забагато б'єшся.»", "Вона відвертається. Кінчики вух — фіолетові. Для темної ельфійки це означає «червоні»."], "reward": {"stat": "luk", "n": 3, "gold": 800}}, {"bond": 80, "title": "Голова ради", "boss": {"key": "vampire", "name": "Архімаг-вампір Морвен", "lvlAdd": 5}, "text": ["Голова ради магів виявився вампіром, що живився магією учнів. Нікса знала. Тому й тікала.", "Після бою Нікса довго мовчить, а потім кладе голову тобі на плече.", "Нікса: «Я більше не тікаю. Бо тепер є куди повертатися. До тебе. ...Кава холоне. Але мені тепло.»"], "reward": {"stat": "int", "n": 5, "gold": 2500, "sigUp": true}}]}, "miu": {"name": "Міу", "title": "Неко-злодійка", "gender": "f", "role": "rogue", "icon": "🐾", "type": "Генкі", "bio": "Найспритніша злодійка континенту. Краде лише в поганих людей. І рибу. Рибу — в усіх.", "meet": {"when": "arrive", "minLvl": 2, "types": ["town", "city", "port", "capital"], "chance": 0.24}, "intro": [{"who": "Оповідач", "text": "Хтось мимохідь торкається твого пояса. Гаманця — нема! Над дахами мелькає білий хвіст."}, {"who": "???", "text": "Ня-ха-ха! Повільний! Дуже повільний! Дякую за гроші, ня~!"}, {"who": "Оповідач", "text": "Ти женешся за нею три квартали і заганяєш у глухий кут. Вона дивиться на тебе великими зеленими очима."}, {"who": "Міу", "text": "Ня... добре, ти мене впіймав. Я Міу! Слух