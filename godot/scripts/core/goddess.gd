static func st() -> Dictionary:
	if not (Game.state.get("goddess") is Dictionary):
		Game.state.goddess = {"next": 3, "n": 0, "mood": 0}
	return Game.state.goddess


static func today() -> int:
	return Game.day_of(float(Game.state.get("minutes", 0.0)))


## Чи час дзвонити (раз на 5–9 днів; з благословенням «Улюблениця богині» — 2–4).
static func due() -> bool:
	return today() >= int(st().next)


static func make_call(p: Dictionary) -> Dictionary:
	var s := st()
	var fav: bool = Origin.mul(p, "calls") > 0
	s.next = today() + (randi_range(2, 4) if fav else randi_range(5, 9))
	s.n = int(s.n) + 1
	var pre := ""
	if float(p.hp) < Player.max_hp(p) * 0.3:
		pre = LINES.lowhp.pick_random() + " "
	elif int(p.gold) > 3000:
		pre = LINES.rich.pick_random() + " "
	elif int(p.gold) < 5:
		pre = LINES.poor.pick_random() + " "
	var t: Dictionary = TALKS[(int(s.n) * 7 + randi() % TALKS.size()) % TALKS.size()].duplicate(true)
	t.text = pre + t.text
	if fav and randf() < 0.5:
		t.gift = true
	return t


## Застосувати відповідь. Повертає рядки результату.
static func answer(p: Dictionary, o: Dictionary, gift := false) -> Array:
	var out: Dictionary = o.get("out", {})
	var res: Array = []
	var s := st()
	if out.has("gold"):
		p.gold = int(p.gold) + int(out.gold)
		res.append("+%d 💰" % int(out.gold))
	if out.has("potion"):
		p.potions = int(p.potions) + int(out.potion)
		res.append("+%d 🧪" % int(out.potion))
	if out.has("ether"):
		p.ethers = int(p.ethers) + int(out.ether)
		res.append("+%d 💧" % int(out.ether))
	if out.has("xp"):
		var n := int(out.xp) + int(p.lvl) * 5
		Player.add_xp(p, n)
		res.append("+%d досвіду" % n)
	if out.has("hp"):
		p.hp = minf(Player.max_hp(p), float(p.hp) + Player.max_hp(p) * float(out.hp))
		res.append("❤ відновлено")
	if out.has("mood"):
		s.mood = clampi(int(s.mood) + int(out.mood), -10, 10)
		res.append("настрій Люмі %s" % ("💖" if int(out.mood) > 0 else "💢"))
	if gift:
		p.gold = int(p.gold) + 100 + int(p.lvl) * 10
		res.append("💌 листівка з сердечком і %d 💰" % (100 + int(p.lvl) * 10))
	return res


static func mood_text() -> String:
	var m := int(st().mood)
	if m >= 6:
		return "Люмі тебе обожнює 💖"
	if m >= 2:
		return "Люмі в гарному настрої 😊"
	if m <= -4:
		return "Люмі ображена 😤"
	return "Люмі заклопотана своїми справами ☕"
