## Короткі репліки за обставинами (без вибору).
const LINES := {
	"lowhp": ["Ой-ой-ой! Твоє здоров'я майже нуль! Випий зілля! Я не хочу знову заповнювати папери!", "Ти червоний як помідор! Тобто здоров'я червоне! Лікуйся, кажу!"],
	"rich": ["Ого, скільки золота! Може, пожертвуєш храму? Ну… мені? Трошечки?", "Ти багатий(а)! Купи собі щось гарне. Мені теж можна."],
	"night": ["Вже ніч. Герої теж мають спати. Навіть ти. Особливо ти.", "Чому не спиш? Я теж не сплю. Бог грому гримить у капслоку."],
	"poor": ["У тебе в кишені вітер і одна монета. Я тебе не для цього переродила!"],
