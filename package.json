{
  "name": "isekay",
  "version": "5.4.0",
  "private": true,
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Khroniky Dyvosvitu",
  "description": "Хроніки Дивосвіту — аніме-RPG у світі меча і магії з живим політичним світом",
  "main": "main.js",
  "author": "Mi-Miracle",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "selftest": "electron . --selftest",
    "dist:win": "electron-builder --win portable nsis --x64"
  },
  "build": {
    "appId": "com.mimiracle.dyvosvit",
    "productName": "Khroniky Dyvosvitu",
    "copyright": "Mi-Miracle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "tts.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Dyvosvit-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Dyvosvit-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dyvosvit-Setup-${version}.exe",
      "shortcutName": "Хроніки Дивосвіту",
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mi-Miracle",
        "repo": "Isekay",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
